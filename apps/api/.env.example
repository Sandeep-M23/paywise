# Postgres (local: docker compose up -d db)
DB_HOST=localhost
DB_PORT=5433
DB_DATABASE=paywise
DB_USERNAME=paywise
DB_PASSWORD=paywise
# true for hosted Postgres that requires TLS (Supabase, RDS, Railway, Render)
DB_SSL=false

# Single HR sign-in. Generate the hash with:
#   npm run hash-password -w @paywise/api -- 'your-password'
HR_EMAIL=hr@acme.test
HR_PASSWORD_HASH=
# Any long random string, e.g. `openssl rand -base64 48`
SESSION_SECRET=
